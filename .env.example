# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Consumed by run.sh, test_ephemeral.sh, prepare_v5_data.sh, and (via
# EnvironmentFile=) the systemd units in deploy/systemd/ -- not auto-loaded by
# the Python code itself. `source .env` before running those scripts by hand,
# e.g.:
#   set -a; source .env; set +a; ./run.sh

# --- vLLM server (miotts.vllm_synthesizer backend) ---
# Must exceed MioConfig.max_new_tokens (1024) plus your longest prompt's token
# count, or requests 400 with "maximum context length" errors.
MAX_MODEL_LEN=2560
GPU_MEM_UTIL=0.6
PORT=8000

# --- Codec server (miotts.codec_server) ---
CODEC_PORT=8001

# --- WebSocket server (miotts.ws_server) ---
WS_PORT=8765

# --- Simple API server (miotts.api_server) ---
API_PORT=8080

# --- Training (miotts/train.py prepare-hf, prepare_v5_data.sh) ---
# Only needed when streaming gated HF audio datasets; leave unset otherwise.
# HF_TOKEN=
# HF_TOKEN_KANNADA=
